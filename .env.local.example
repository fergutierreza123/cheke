# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings → API). Never commit .env.local — it's already in .gitignore.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Phase 4 — WhatsApp Cloud API (test number). See README for where each of
# these comes from in the Meta Developer dashboard.
#
# Service-role key: Supabase Project Settings → API → service_role secret.
# The webhook has no logged-in user, so it uses this to bypass RLS —
# never expose it to the browser, never prefix it with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
#
# Meta App Dashboard → WhatsApp → API Setup:
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=make-up-any-random-string-yourself

# Chekelin (AI first-reply assistant) — console.anthropic.com → API Keys.
# Server-only; without it, Chekelin silently skips replying (no crash).
# ANTHROPIC_API_KEY=

# Voice notes in words (chekelin reads them, Chat shows "Transcripción") —
# platform.openai.com → API keys. About US$0.40 per business per month.
# Server-only; without it, voice notes simply aren't transcribed (no crash).
# OPENAI_API_KEY=
#
# Only for the voice-note bake-off (npm run bakeoff:transcribe), never on
# Vercel: elevenlabs.io → API keys.
# ELEVENLABS_API_KEY=

# Catálogo product photos — removes the background and puts the product on
# white automatically. From remove.bg → dashboard → API Key. Server-only;
# without it, photos upload as-is (no background removal, no crash).
# REMOVE_BG_API_KEY=
#
# Which background-removal service to use: removebg (default), photoroom or
# pixian. Whichever you pick, only its "where is the product" outline is used;
# the product pixels always come from your original photo. If the service
# fails, the original photo is saved instead (the product still saves).
# BG_REMOVAL_PROVIDER=removebg
# Photoroom → app.photoroom.com/api-dashboard → API key.
# PHOTOROOM_API_KEY=
# Pixian → pixian.ai/api → API credentials (id + secret). PIXIAN_TEST=true
# uses Pixian's free, watermarked test mode.
# PIXIAN_API_ID=
# PIXIAN_API_SECRET=
# PIXIAN_TEST=

# Phone notifications (the iPhone/Android app). Firebase console → Project
# settings → Service accounts → "Generate new private key", then put the
# whole downloaded JSON on ONE line here (and in Vercel). Server-only;
# without it, no push is sent (no crash). Also run migration 0010.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# WhatsApp connection for each client business ("Conectar WhatsApp" in the
# Canales screen — Meta Embedded Signup). Needs a verified Meta business.
# NEXT_PUBLIC_META_APP_ID is the same app as WHATSAPP_APP_SECRET above;
# NEXT_PUBLIC_META_CONFIG_ID comes from Meta App → WhatsApp → Embedded Signup
# → "Create configuration". Without these the Canales screen just shows
# "pending" (no crash).
# NEXT_PUBLIC_META_APP_ID=
# NEXT_PUBLIC_META_CONFIG_ID=
#
# Instagram DMs + Facebook Messenger ("Conectar Instagram y Facebook" in
# Canales): a SECOND Facebook Login for Business configuration on the same
# app, with the Page + Instagram messaging permissions. Meta App → Facebook
# Login for Business → Configurations → "Create configuration". The webhook
# for both is /api/meta/webhook (same verify token and app secret as above).
# NEXT_PUBLIC_META_MESSAGING_CONFIG_ID=
#
# Key that encrypts each business's WhatsApp token in the database. Generate
# once with:  openssl rand -base64 32   — and NEVER change it afterwards
# (stored tokens couldn't be decrypted). Server-only.
# CHANNEL_TOKEN_KEY=
#
# Code from Meta's "verify your domain" step (gets published as a <meta> tag).
# NEXT_PUBLIC_META_DOMAIN_VERIFICATION=
#
# "Acceso para revisores" (login screen): the fixed email + password Apple
# and Google reviewers use to open a pre-filled demo Negocio where nothing is
# sent to WhatsApp. Leave unset to hide it. Use an email that is NOT anyone's
# real cheKe account, and a password of 12+ characters (openssl rand -base64 18).
# Needs supabase/migrations/0015_reviewer_demo.sql. Server-only.
# REVIEWER_EMAIL=
# REVIEWER_PASSWORD=

# Vercel Cron (chekelin 5/10-minute timers, weekly Sugerencias). Vercel sends
# it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/*; without it
# those routes refuse to run. Make one with: openssl rand -hex 32. Server-only.
# CRON_SECRET=
